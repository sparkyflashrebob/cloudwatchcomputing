  <Document>
    <name>🌊 CWC Marin Flood Watch WET (22 Live Locations)</name>
    <open>1</open>
    <description><![CDATA[
      <h2>CWC Marin County Coastal Flood & Elevation Watch</h2>
      <p><b>Live Tide Level:</b> 2.58' NAVD88 (2.67' MLLW)</p>
      <p>Real-time surveyed road crown elevations, curb gutter surcharges, and flood monitoring benchmarks across all 22 Marin County stations.</p>
    ]]></description>

    <!-- Styles for Green, Yellow, and Red Pushpins -->
    <Style id="greenPin">
      <IconStyle>
        <color>ff44c522</color>
        <scale>1.2</scale>
        <Icon>
          <href>https://maps.google.com/mapfiles/kml/paddle/grn-circle.png</href>
        </Icon>
      </IconStyle>
      <LabelStyle><scale>0.85</scale></LabelStyle>
    </Style>

    <Style id="yellowPin">
      <IconStyle>
        <color>ff0bbef5</color>
        <scale>1.3</scale>
        <Icon>
          <href>https://maps.google.com/mapfiles/kml/paddle/ylw-circle.png</href>
        </Icon>
      </IconStyle>
      <LabelStyle><scale>0.85</scale></LabelStyle>
    </Style>

    <Style id="redPin">
