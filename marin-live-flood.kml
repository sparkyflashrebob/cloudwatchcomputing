      <name>🌊 NOAA LiDAR Coastal Flood Inundation Model</name>
      <open>1</open>
      <description>NOAA Digital Coast 1-Meter Sea Level Rise &amp; King Tide Inundation Extent for Marin County</description>
      <GroundOverlay>
        <name>NOAA 1ft Coastal Inundation Extent (~7.25' MLLW King Tide)</name>
        <Icon>
          <href>https://coast.noaa.gov/arcgis/rest/services/dc_slr/slr_1ft/MapServer/export?bbox=-122.95,37.80,-122.42,38.25&amp;bboxSR=4326&amp;imageSR=4326&amp;size=1600,1600&amp;format=png32&amp;transparent=true&amp;f=image</href>
        </Icon>
        <LatLonBox>
          <north>38.25</north>
          <south>37.80</south>
          <east>-122.42</east>
          <west>-122.95</west>
        </LatLonBox>
      </GroundOverlay>
    </Folder>

